        "no_answer_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "No Answer Accuracy"
        }
      },
      "required": [
        "case_count",
        "answerable_count",
        "no_answer_count",
        "mean_recall",
        "mean_precision",
        "mean_reciprocal_rank",
        "mean_ndcg",
        "hit_rate",
        "no_answer_accuracy"
      ],
      "title": "SafeMetrics",
      "type": "object"
    },
    "SafeQualityReport": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "title": "Passed",
